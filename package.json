{
  "name": "pt-srikandi-factory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply srikandi-factory-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply srikandi-factory-db --remote",
    "db:seed:local": "wrangler d1 execute srikandi-factory-db --local --file=migrations/0002_seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "hono": "^4.9.7",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.3",
    "typescript": "^5.8.3",
    "vite": "^7.1.7",
    "wrangler": "^4.38.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
